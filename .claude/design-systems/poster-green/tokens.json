{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "The Poster green design system.",
  "$extensions": {
    "ai-editor": {
      "id": "poster-green",
      "name": "Poster green",
      "preset": "poster-green",
      "surface": "card",
      "case": "as_is",
      "texture": "print",
      "textureAmount": 1,
      "decor": "none"
    }
  },
  "color": {
    "$type": "color",
    "ground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.117647,
          0.290196,
          0.172549
        ],
        "alpha": 1,
        "hex": "#1E4A2C"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.956863,
          0.937255,
          0.886275
        ],
        "alpha": 1,
        "hex": "#F4EFE2"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.956863,
          0.937255,
          0.886275
        ],
        "alpha": 0.66,
        "hex": "#F4EFE2"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.960784,
          0.839216,
          0.239216
        ],
        "alpha": 1,
        "hex": "#F5D63D"
      }
    },
    "accentInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.117647,
          0.290196,
          0.172549
        ],
        "alpha": 1,
        "hex": "#1E4A2C"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.956863,
          0.937255,
          0.886275
        ],
        "alpha": 0.2,
        "hex": "#F4EFE2"
      }
    },
    "mark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.882353,
          0.301961
        ],
        "alpha": 1,
        "hex": "#FFE14D"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    }
  },
  "typography": {
    "body": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "IBM Plex Sans"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "display": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Newsreader"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "letterSpacing": {
        "$type": "number",
        "$value": -0.022,
        "$extensions": {
          "ai-editor": {
            "unit": "em"
          }
        }
      }
    },
    "serif": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Instrument Serif"
      },
      "$description": "the italic emphasis word; [] for none"
    }
  },
  "radius": {
    "card": {
      "$type": "number",
      "$value": 3,
      "$extensions": {
        "ai-editor": {
          "unit": "pctShortSide"
        }
      },
      "$description": "corner radius, % of the card's short side"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [],
      "$extensions": {
        "ai-editor": {
          "style": "none"
        }
      }
    }
  }
}
