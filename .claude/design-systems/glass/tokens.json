{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "The Glass design system.",
  "$extensions": {
    "ai-editor": {
      "id": "glass",
      "name": "Glass",
      "preset": "glass",
      "surface": "glass",
      "case": "as_is",
      "texture": "none",
      "textureAmount": 0.55,
      "decor": "none"
    }
  },
  "color": {
    "$type": "color",
    "ground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.054902,
          0.058824,
          0.07451
        ],
        "alpha": 0.78,
        "hex": "#0E0F13"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.960784,
          0.960784,
          0.94902
        ],
        "alpha": 1,
        "hex": "#F5F5F2"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.960784,
          0.960784,
          0.94902
        ],
        "alpha": 0.62,
        "hex": "#F5F5F2"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.486275,
          0.94902,
          0.690196
        ],
        "alpha": 1,
        "hex": "#7CF2B0"
      }
    },
    "accentInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043137,
          0.101961,
          0.070588
        ],
        "alpha": 1,
        "hex": "#0B1A12"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 0.16,
        "hex": "#FFFFFF"
      }
    },
    "mark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.882353,
          0.301961
        ],
        "alpha": 1,
        "hex": "#FFE14D"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    }
  },
  "typography": {
    "body": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Montserrat"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "display": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Montserrat"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "letterSpacing": {
        "$type": "number",
        "$value": -0.022,
        "$extensions": {
          "ai-editor": {
            "unit": "em"
          }
        }
      }
    },
    "serif": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": []
      },
      "$description": "the italic emphasis word; [] for none"
    }
  },
  "radius": {
    "card": {
      "$type": "number",
      "$value": 12,
      "$extensions": {
        "ai-editor": {
          "unit": "pctShortSide"
        }
      },
      "$description": "corner radius, % of the card's short side"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.22,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1.2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0.2,
            "unit": "px"
          },
          "blur": {
            "value": 0.5,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ai-editor": {
          "style": "soft"
        }
      }
    }
  }
}
