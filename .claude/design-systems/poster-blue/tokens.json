{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "The Poster blue design system.",
  "$extensions": {
    "ai-editor": {
      "id": "poster-blue",
      "name": "Poster blue",
      "preset": "poster-blue",
      "surface": "card",
      "case": "as_is",
      "texture": "grain",
      "textureAmount": 1,
      "decor": "none"
    }
  },
  "color": {
    "$type": "color",
    "ground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.121569,
          0.247059,
          0.819608
        ],
        "alpha": 1,
        "hex": "#1F3FD1"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.956863,
          0.937255,
          0.886275
        ],
        "alpha": 1,
        "hex": "#F4EFE2"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.956863,
          0.937255,
          0.886275
        ],
        "alpha": 0.7,
        "hex": "#F4EFE2"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.478431,
          0.34902
        ],
        "alpha": 1,
        "hex": "#FF7A59"
      }
    },
    "accentInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.066667,
          0.066667,
          0.066667
        ],
        "alpha": 1,
        "hex": "#111111"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.956863,
          0.937255,
          0.886275
        ],
        "alpha": 0.22,
        "hex": "#F4EFE2"
      }
    },
    "mark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.882353,
          0.301961
        ],
        "alpha": 1,
        "hex": "#FFE14D"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    }
  },
  "typography": {
    "body": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "IBM Plex Sans"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "display": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Newsreader"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "letterSpacing": {
        "$type": "number",
        "$value": -0.022,
        "$extensions": {
          "ai-editor": {
            "unit": "em"
          }
        }
      }
    },
    "serif": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Instrument Serif"
      },
      "$description": "the italic emphasis word; [] for none"
    }
  },
  "radius": {
    "card": {
      "$type": "number",
      "$value": 3,
      "$extensions": {
        "ai-editor": {
          "unit": "pctShortSide"
        }
      },
      "$description": "corner radius, % of the card's short side"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [],
      "$extensions": {
        "ai-editor": {
          "style": "none"
        }
      }
    }
  }
}
