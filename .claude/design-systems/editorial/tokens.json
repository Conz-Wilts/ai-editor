{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "Editorial, warm paper",
  "$extensions": {
    "ai-editor": {
      "id": "editorial",
      "name": "Editorial",
      "preset": "editorial",
      "surface": "card",
      "case": "as_is",
      "texture": "grain",
      "textureAmount": 0.55,
      "decor": "none"
    }
  },
  "color": {
    "$type": "color",
    "ground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.94902,
          0.933333,
          0.901961
        ],
        "alpha": 1,
        "hex": "#F2EEE6"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078431,
          0.078431,
          0.078431
        ],
        "alpha": 1,
        "hex": "#141414"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.431373,
          0.415686,
          0.388235
        ],
        "alpha": 1,
        "hex": "#6E6A63"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898039,
          0.282353,
          0.172549
        ],
        "alpha": 1,
        "hex": "#E5482C"
      }
    },
    "accentInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078431,
          0.078431,
          0.078431
        ],
        "alpha": 0.14,
        "hex": "#141414"
      }
    },
    "mark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.882353,
          0.301961
        ],
        "alpha": 1,
        "hex": "#FFE14D"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    }
  },
  "typography": {
    "body": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "IBM Plex Sans"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "display": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Newsreader"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "letterSpacing": {
        "$type": "number",
        "$value": -0.022,
        "$extensions": {
          "ai-editor": {
            "unit": "em"
          }
        }
      }
    },
    "serif": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Instrument Serif"
      },
      "$description": "the italic emphasis word; [] for none"
    }
  },
  "radius": {
    "card": {
      "$type": "number",
      "$value": 3,
      "$extensions": {
        "ai-editor": {
          "unit": "pctShortSide"
        }
      },
      "$description": "corner radius, % of the card's short side"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.22,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1.2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0.2,
            "unit": "px"
          },
          "blur": {
            "value": 0.5,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ai-editor": {
          "style": "soft"
        }
      }
    }
  }
}
