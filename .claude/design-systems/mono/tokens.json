{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "Mono, plain type",
  "$extensions": {
    "ai-editor": {
      "id": "mono",
      "name": "Mono",
      "preset": "mono",
      "surface": "card",
      "case": "as_is",
      "texture": "none",
      "textureAmount": 0.55,
      "decor": "none"
    }
  },
  "color": {
    "$type": "color",
    "ground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039216,
          0.039216,
          0.039216
        ],
        "alpha": 1,
        "hex": "#0A0A0A"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.466667,
          0.466667,
          0.466667
        ],
        "alpha": 1,
        "hex": "#777777"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039216,
          0.039216,
          0.039216
        ],
        "alpha": 1,
        "hex": "#0A0A0A"
      }
    },
    "accentInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "alpha": 0.12,
        "hex": "#000000"
      }
    },
    "mark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.882353,
          0.301961
        ],
        "alpha": 1,
        "hex": "#FFE14D"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    }
  },
  "typography": {
    "body": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "IBM Plex Sans"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "display": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "IBM Plex Mono"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "letterSpacing": {
        "$type": "number",
        "$value": -0.022,
        "$extensions": {
          "ai-editor": {
            "unit": "em"
          }
        }
      }
    },
    "serif": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Instrument Serif"
      },
      "$description": "the italic emphasis word; [] for none"
    }
  },
  "radius": {
    "card": {
      "$type": "number",
      "$value": 3,
      "$extensions": {
        "ai-editor": {
          "unit": "pctShortSide"
        }
      },
      "$description": "corner radius, % of the card's short side"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.22,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1.2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0.2,
            "unit": "px"
          },
          "blur": {
            "value": 0.5,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ai-editor": {
          "style": "soft"
        }
      }
    }
  }
}
