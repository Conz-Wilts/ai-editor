{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "$description": "The Poster red design system.",
  "$extensions": {
    "ai-editor": {
      "id": "poster-red",
      "name": "Poster red",
      "preset": "poster-red",
      "surface": "card",
      "case": "upper",
      "texture": "print",
      "textureAmount": 1,
      "decor": "none"
    }
  },
  "color": {
    "$type": "color",
    "ground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.886275,
          0.196078,
          0.105882
        ],
        "alpha": 1,
        "hex": "#E2321B"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.066667,
          0.066667,
          0.066667
        ],
        "alpha": 1,
        "hex": "#111111"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.066667,
          0.066667,
          0.066667
        ],
        "alpha": 0.62,
        "hex": "#111111"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.968627,
          0.823529,
          0.231373
        ],
        "alpha": 1,
        "hex": "#F7D23B"
      }
    },
    "accentInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.066667,
          0.066667,
          0.066667
        ],
        "alpha": 1,
        "hex": "#111111"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.066667,
          0.066667,
          0.066667
        ],
        "alpha": 0.2,
        "hex": "#111111"
      }
    },
    "mark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          0.882353,
          0.301961
        ],
        "alpha": 1,
        "hex": "#FFE14D"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1,
        "hex": "#FFFFFF"
      }
    }
  },
  "typography": {
    "body": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "IBM Plex Sans"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "display": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Anton"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 400
      },
      "letterSpacing": {
        "$type": "number",
        "$value": 0,
        "$extensions": {
          "ai-editor": {
            "unit": "em"
          }
        }
      }
    },
    "serif": {
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Instrument Serif"
      },
      "$description": "the italic emphasis word; [] for none"
    }
  },
  "radius": {
    "card": {
      "$type": "number",
      "$value": 3,
      "$extensions": {
        "ai-editor": {
          "unit": "pctShortSide"
        }
      },
      "$description": "corner radius, % of the card's short side"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.0,
              0.0
            ],
            "alpha": 1,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 1.1,
            "unit": "px"
          },
          "offsetY": {
            "value": 1.1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ai-editor": {
          "style": "hard"
        }
      }
    }
  }
}
