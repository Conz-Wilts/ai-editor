{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/skills/setup/scripts/setup.py\" doctor --quiet 2>/dev/null || py \"${CLAUDE_PROJECT_DIR}/.claude/skills/setup/scripts/setup.py\" doctor --quiet 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/askhook.py\" 2>/dev/null || py \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/askhook.py\" 2>/dev/null || true",
            "timeout": 86400,
            "statusMessage": "Asking in the editor window"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" 2>/dev/null || py \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" notify 2>/dev/null || py \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" notify 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" clear 2>/dev/null || py \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" clear 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" stop 2>/dev/null || py \"${CLAUDE_PROJECT_DIR}/.claude/lib/ai_editor/toolhook.py\" stop 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
