{
  "id": "plain",
  "name": "Plain image",
  "description": "An image card drawn as it is.",
  "kind": "image-format",
  "entry": "builtin:Capture",
  "order": 40,
  "aspects": [
    "9:16",
    "16:9"
  ],
  "defaultDurationS": 2.5,
  "entrance": "scale",
  "floating": false,
  "moving": false,
  "contentAspect": null,
  "fixedBox": false,
  "boxOk": false,
  "imageFormat": true,
  "legacy": false,
  "scene": false,
  "splitFirst": false,
  "wantsPicture": true,
  "tags": [
    "image"
  ],
  "preview": null,
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "src": {
        "type": "string",
        "description": "an image in the edit folder, e.g. images/capture-1.png"
      },
      "size": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "the image's [width, height] in px"
      },
      "word_at": {
        "type": [
          "number",
          "null"
        ],
        "description": "seconds after the card lands when its word is said (plan.py fills it)"
      },
      "enter": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured entrance (plan.py fills it)"
      },
      "exit": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured exit (plan.py fills it)"
      },
      "ambient": {
        "description": "the camera's slow push and drift (plan.py fills it)"
      }
    },
    "required": [
      "src"
    ],
    "additionalProperties": true
  }
}
