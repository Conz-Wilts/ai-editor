{
  "id": "notes",
  "name": "Notes",
  "description": "A notes card whose lines land on their words.",
  "kind": "overlay",
  "entry": "builtin:Notes",
  "order": 13,
  "aspects": [
    "9:16",
    "16:9"
  ],
  "defaultDurationS": 2.5,
  "entrance": "slide",
  "floating": true,
  "moving": true,
  "contentAspect": 2.2,
  "fixedBox": false,
  "boxOk": false,
  "imageFormat": false,
  "legacy": false,
  "scene": false,
  "splitFirst": false,
  "wantsPicture": false,
  "tags": [
    "list"
  ],
  "preview": null,
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "avatar": {
        "type": "string"
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "sub": {
              "type": "string"
            },
            "time": {
              "type": "string"
            },
            "src": {
              "type": "string"
            },
            "word": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": [
            "text"
          ]
        },
        "minItems": 1
      },
      "word_at": {
        "type": [
          "number",
          "null"
        ],
        "description": "seconds after the card lands when its word is said (plan.py fills it)"
      },
      "enter": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured entrance (plan.py fills it)"
      },
      "exit": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured exit (plan.py fills it)"
      },
      "ambient": {
        "description": "the camera's slow push and drift (plan.py fills it)"
      }
    },
    "required": [
      "lines"
    ],
    "additionalProperties": true
  },
  "example": {
    "title": "Today",
    "lines": [
      {
        "text": "Record the intro"
      },
      {
        "text": "Cut the retakes"
      }
    ]
  }
}
