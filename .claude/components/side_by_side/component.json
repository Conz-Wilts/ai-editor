{
  "id": "side_by_side",
  "name": "Side by side",
  "description": "Two real screenshots, tilted toward each other.",
  "kind": "overlay",
  "entry": "builtin:SideBySide",
  "order": 8,
  "aspects": [
    "9:16",
    "16:9"
  ],
  "defaultDurationS": 2.5,
  "entrance": "slide",
  "floating": true,
  "moving": true,
  "contentAspect": 2.6,
  "fixedBox": false,
  "boxOk": false,
  "imageFormat": false,
  "legacy": false,
  "scene": false,
  "splitFirst": false,
  "wantsPicture": true,
  "tags": [
    "capture",
    "compare"
  ],
  "preview": null,
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "a": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "description": "an image in the edit folder, e.g. images/capture-1.png"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "the image's [width, height] in px"
          },
          "crop": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "label": {
            "type": "string"
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "box",
                    "ring",
                    "underline",
                    "bracket",
                    "pill",
                    "dim",
                    "highlight"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x, y, w, h] in image px"
                },
                "rects": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "description": "one per line (highlight)"
                },
                "label": {
                  "type": "string"
                },
                "side": {
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "at": {
                  "type": "number",
                  "description": "seconds after the card lands"
                },
                "at_word": {
                  "type": "string",
                  "description": "the word it lands on"
                },
                "at_s": {
                  "type": "number"
                }
              },
              "additionalProperties": true,
              "required": [
                "kind"
              ]
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "src"
        ]
      },
      "b": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "description": "an image in the edit folder, e.g. images/capture-1.png"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "the image's [width, height] in px"
          },
          "crop": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "label": {
            "type": "string"
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "box",
                    "ring",
                    "underline",
                    "bracket",
                    "pill",
                    "dim",
                    "highlight"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x, y, w, h] in image px"
                },
                "rects": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "description": "one per line (highlight)"
                },
                "label": {
                  "type": "string"
                },
                "side": {
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "at": {
                  "type": "number",
                  "description": "seconds after the card lands"
                },
                "at_word": {
                  "type": "string",
                  "description": "the word it lands on"
                },
                "at_s": {
                  "type": "number"
                }
              },
              "additionalProperties": true,
              "required": [
                "kind"
              ]
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "src"
        ]
      },
      "arrow": {
        "type": "boolean",
        "description": "before -> after"
      },
      "word_at": {
        "type": [
          "number",
          "null"
        ],
        "description": "seconds after the card lands when its word is said (plan.py fills it)"
      },
      "enter": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured entrance (plan.py fills it)"
      },
      "exit": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured exit (plan.py fills it)"
      },
      "ambient": {
        "description": "the camera's slow push and drift (plan.py fills it)"
      }
    },
    "required": [
      "a",
      "b"
    ],
    "additionalProperties": true
  }
}
