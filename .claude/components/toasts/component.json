{
  "id": "toasts",
  "name": "Notifications",
  "description": "Real notifications drop in from above and stack.",
  "kind": "overlay",
  "entry": "builtin:Toasts",
  "order": 6,
  "aspects": [
    "9:16",
    "16:9"
  ],
  "defaultDurationS": 2.5,
  "entrance": "slide",
  "floating": true,
  "moving": true,
  "contentAspect": 3.2,
  "fixedBox": false,
  "boxOk": false,
  "imageFormat": false,
  "legacy": false,
  "scene": false,
  "splitFirst": false,
  "wantsPicture": false,
  "tags": [
    "ui"
  ],
  "preview": null,
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "src": {
              "type": "string"
            },
            "logo": {
              "type": [
                "object",
                "string"
              ]
            },
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "at": {
              "type": "number"
            },
            "word": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": [
            "title"
          ]
        },
        "minItems": 1
      },
      "word_at": {
        "type": [
          "number",
          "null"
        ],
        "description": "seconds after the card lands when its word is said (plan.py fills it)"
      },
      "enter": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured entrance (plan.py fills it)"
      },
      "exit": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured exit (plan.py fills it)"
      },
      "ambient": {
        "description": "the camera's slow push and drift (plan.py fills it)"
      }
    },
    "required": [
      "items"
    ],
    "additionalProperties": true
  },
  "example": {
    "items": [
      {
        "app": "Mail",
        "title": "New order",
        "body": "Order #1042 paid"
      }
    ]
  }
}
