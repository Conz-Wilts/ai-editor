{
  "id": "social_post",
  "name": "Social post",
  "description": "A real X post, Reddit post or YouTube comment, the quoted phrase marked.",
  "kind": "template",
  "entry": "builtin:SocialPost",
  "order": 22,
  "aspects": [
    "9:16",
    "16:9"
  ],
  "defaultDurationS": 2.5,
  "entrance": "slide",
  "floating": true,
  "moving": false,
  "contentAspect": 2.2,
  "fixedBox": false,
  "boxOk": false,
  "imageFormat": false,
  "legacy": false,
  "scene": false,
  "splitFirst": false,
  "wantsPicture": false,
  "tags": [
    "social",
    "quote"
  ],
  "preview": null,
  "propsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "platform": {
        "enum": [
          "x",
          "reddit",
          "youtube"
        ]
      },
      "name": {
        "type": "string"
      },
      "handle": {
        "type": "string"
      },
      "avatar": {
        "type": "string"
      },
      "text": {
        "type": "string",
        "description": "copied verbatim from the real post"
      },
      "highlight": {
        "type": "string"
      },
      "likes": {
        "type": [
          "string",
          "number"
        ]
      },
      "replies": {
        "type": [
          "string",
          "number"
        ]
      },
      "reposts": {
        "type": [
          "string",
          "number"
        ]
      },
      "time": {
        "type": "string"
      },
      "subreddit": {
        "type": "string"
      },
      "logo_src": {
        "type": "string"
      },
      "excerpt": {
        "type": "boolean"
      },
      "word_at": {
        "type": [
          "number",
          "null"
        ],
        "description": "seconds after the card lands when its word is said (plan.py fills it)"
      },
      "enter": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured entrance (plan.py fills it)"
      },
      "exit": {
        "type": [
          "object",
          "null"
        ],
        "description": "the creator's measured exit (plan.py fills it)"
      },
      "ambient": {
        "description": "the camera's slow push and drift (plan.py fills it)"
      }
    },
    "required": [
      "name",
      "text"
    ],
    "additionalProperties": true
  },
  "example": {
    "platform": "x",
    "name": "Ada",
    "handle": "ada",
    "text": "Shipping the editor today.",
    "highlight": "Shipping",
    "likes": "1.2K"
  }
}
